primary_color = Color(0.82, 0.98, 1, 1)
secondary_color = Color(0.16, 0.62, 1, 1)
tertiary_color = Color(0.02, 0.18, 0.82, 1)
light_color = Color(0.16, 0.62, 1, 1)
light_energy = 1.4
